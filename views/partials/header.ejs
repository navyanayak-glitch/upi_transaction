<!DOCTYPE html>
<% const activePath = typeof currentPath !== 'undefined' ? currentPath : ''; %>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0b1220">
  <title><%= title %> | UPI System</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body data-authenticated="<%= currentUser ? 'true' : 'false' %>" data-user-id="<%= currentUser ? currentUser.user_id : '' %>">
  <nav class="navbar navbar-expand-lg navbar-dark app-navbar shadow-sm">
    <div class="container">
      <a class="navbar-brand app-brand" href="/">
        <span class="brand-mark">U</span>
        <span>UPI Manager</span>
      </a>
      <button class="navbar-toggler app-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNavbar">
        <ul class="navbar-nav ms-auto align-items-lg-center nav-menu">
          <% if (currentUser) { %>
            <li class="nav-item"><a class="nav-link <%= activePath === '/dashboard' ? 'active' : '' %>" href="/dashboard">Dashboard</a></li>
            <li class="nav-item"><a class="nav-link <%= activePath === '/banks' ? 'active' : '' %>" href="/banks">Banks</a></li>
            <li class="nav-item"><a class="nav-link <%= activePath.startsWith('/bank') ? 'active' : '' %>" href="/bank/accounts">Accounts</a></li>
            <li class="nav-item"><a class="nav-link <%= activePath.startsWith('/upi') ? 'active' : '' %>" href="/upi/pay">Send Money</a></li>
            <li class="nav-item"><a class="nav-link <%= activePath.startsWith('/transaction') ? 'active' : '' %>" href="/transaction/history">History</a></li>
            <li class="nav-item nav-user">
              <a class="nav-link profile-link <%= activePath === '/profile' ? 'active' : '' %>" href="/profile">
                <span class="user-avatar"><%= currentUser.name ? currentUser.name.charAt(0).toUpperCase() : 'U' %></span>
                <span><%= currentUser.name || 'Profile' %></span>
              </a>
            </li>
            <li class="nav-item"><a class="nav-link logout-link" href="/logout">Logout</a></li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link <%= activePath === '/' ? 'active' : '' %>" href="/">Home</a></li>
            <li class="nav-item"><a class="nav-link <%= activePath === '/login' ? 'active' : '' %>" href="/login">Login</a></li>
            <li class="nav-item"><a class="nav-link nav-pill <%= activePath === '/signup' ? 'active' : '' %>" href="/signup">Create Account</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>
  <main class="page-shell">
    <div class="container">
      <%- include('alerts') %>
