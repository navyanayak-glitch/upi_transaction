<%- include('partials/header') %>

<section class="auth-scene auth-login">
  <div class="auth-visual">
    <span class="eyebrow">Welcome back</span>
    <h1>Continue your payment control room.</h1>
    <p>Check balances, send money, and review recent activity from one calm dashboard.</p>
    <div class="auth-visual-card">
      <span>Last payment</span>
      <strong>Rs. 1,200 received</strong>
      <small>Reference UPI93815</small>
    </div>
  </div>

  <div class="auth-card auth-panel">
    <span class="eyebrow">Account access</span>
    <h2 class="mb-2">Login</h2>
    <p class="text-muted mb-4">Enter your details to open your UPI workspace.</p>
    <form action="/login" method="POST">
      <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" name="email_id" class="form-control form-control-lg" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Password</label>
        <input type="password" name="password" class="form-control form-control-lg" required>
      </div>
      <button class="btn btn-primary btn-lg w-100" type="submit">Login</button>
    </form>
    <p class="mt-3 mb-0 text-center">New user? <a href="/signup">Create account</a></p>
  </div>
</section>

<%- include('partials/footer') %>
