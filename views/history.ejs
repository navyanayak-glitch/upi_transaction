<%- include('partials/header') %>
<% const safeFilters = typeof filters !== 'undefined' && filters ? filters : {}; %>
<% const safeTransactions = Array.isArray(transactions) ? transactions : []; %>
<% const highlightedTransactionId = Number(safeFilters.highlight || 0); %>
<%
  const exportQuery = Object.entries(safeFilters)
    .filter(([key, value]) => key !== 'highlight' && value)
    .map(([key, value]) => `${encodeURIComponent(key)}=${encodeURIComponent(value)}`)
    .join('&');
%>

<div class="history-toolbar mt-4 mb-3">
  <div>
    <span class="eyebrow">Ledger</span>
    <h1 class="h3 mb-1">Transaction History</h1>
    <p class="text-muted mb-0"><%= safeTransactions.length %> matching transactions</p>
  </div>
  <a class="btn btn-outline-primary" href="/transaction/export<%= exportQuery ? `?${exportQuery}` : '' %>">Export CSV</a>
</div>

<div class="filter-panel surface mb-3">
  <form class="row g-2" action="/transaction/history" method="GET">
    <div class="col-lg-3 col-md-6">
      <input type="text" name="reference_no" class="form-control" placeholder="Search reference number" value="<%= safeFilters.reference_no || '' %>">
    </div>
    <div class="col-lg-2 col-md-6">
      <select name="status" class="form-select">
        <option value="">All Status</option>
        <option value="SUCCESS" <%= safeFilters.status === 'SUCCESS' ? 'selected' : '' %>>SUCCESS</option>
        <option value="FAILED" <%= safeFilters.status === 'FAILED' ? 'selected' : '' %>>FAILED</option>
      </select>
    </div>
    <div class="col-lg-2 col-md-6">
      <select name="direction" class="form-select">
        <option value="">Sent & Received</option>
        <option value="sent" <%= safeFilters.direction === 'sent' ? 'selected' : '' %>>Sent</option>
        <option value="received" <%= safeFilters.direction === 'received' ? 'selected' : '' %>>Received</option>
      </select>
    </div>
    <div class="col-lg-2 col-md-6">
      <input type="date" name="date_from" class="form-control" value="<%= safeFilters.date_from || '' %>" aria-label="From date">
    </div>
    <div class="col-lg-2 col-md-6">
      <input type="date" name="date_to" class="form-control" value="<%= safeFilters.date_to || '' %>" aria-label="To date">
    </div>
    <div class="col-lg-1 col-md-6 d-grid">
      <button class="btn btn-primary" type="submit">Apply</button>
    </div>
    <div class="col-md-3">
      <input type="number" name="amount_min" class="form-control" min="0" step="0.01" placeholder="Min amount" value="<%= safeFilters.amount_min || '' %>">
    </div>
    <div class="col-md-3">
      <input type="number" name="amount_max" class="form-control" min="0" step="0.01" placeholder="Max amount" value="<%= safeFilters.amount_max || '' %>">
    </div>
    <div class="col-md-3 d-grid">
      <a href="/transaction/history" class="btn btn-light">Clear Filters</a>
    </div>
  </form>
</div>

<div class="table-responsive surface reveal-card">
  <table class="table align-middle mb-0">
    <thead>
      <tr>
        <th>Reference</th>
        <th>Sender</th>
        <th>Receiver</th>
        <th>Amount</th>
        <th>Status</th>
        <th>Date</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% if (safeTransactions.length === 0) { %>
        <tr><td colspan="7" class="text-center text-muted">No transactions found.</td></tr>
      <% } %>
      <% safeTransactions.forEach(transaction => { %>
        <tr id="transaction-<%= transaction.tr_id %>" class="<%= transaction.tr_id === highlightedTransactionId ? 'transaction-highlight' : '' %>">
          <td><%= transaction.reference_no %></td>
          <td><%= transaction.sender_upi %></td>
          <td><%= transaction.receiver_upi %></td>
          <td class="<%= transaction.sender_id === currentUser.user_id ? 'amount-debit' : 'amount-credit' %>">
            <%= transaction.sender_id === currentUser.user_id ? '-' : '+' %> Rs. <%= Number(transaction.amount).toFixed(2) %>
          </td>
          <td><span class="badge status-<%= transaction.status.toLowerCase() %>"><%= transaction.status %></span></td>
          <td><%= new Date(transaction.created_at).toLocaleString() %></td>
          <td><a href="/transaction/<%= transaction.tr_id %>" class="btn btn-sm btn-outline-primary">View</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
